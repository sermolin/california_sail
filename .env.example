# Timezone for forecast display (default: America/Los_Angeles)
TIMEZONE_DEFAULT=America/Los_Angeles
# Number of forecast days (default: 7, range 1-16)
FORECAST_DAYS=7
# HTTP client
HTTP_TIMEOUT_SECONDS=8
HTTP_RETRIES=2
# Cache
CACHE_TTL_SECONDS=900
CACHE_BACKEND=memory

# ── Telegram bot (Phase 4b) ──────────────────────────────────────────────────
# Get a token from @BotFather on Telegram.
# Required for the bot to run (polling or webhook mode).
TELEGRAM_BOT_TOKEN=

# Full HTTPS URL of the california-sail-api Cloud Run service.
# When set, the FastAPI service auto-registers the Telegram webhook on startup.
# Leave empty for local dev (use `python -m app.bot.telegram` for polling instead).
WEBHOOK_URL=

# ── Natural-language agent (Phase 4c) ────────────────────────────────────────
# API key from https://openrouter.ai — required to enable NL conversations.
# Without this key the bot still works but falls back to slash-commands only.
OPENROUTER_API_KEY=

# Any model slug available on OpenRouter (see https://openrouter.ai/models).
# Examples:
#   anthropic/claude-3-haiku       — fast, cheap, excellent tool use
#   anthropic/claude-3.5-sonnet    — more capable, higher cost
#   openai/gpt-4o-mini             — OpenAI alternative
#   meta-llama/llama-3-70b-instruct — open-source option
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Maximum number of messages kept in per-user conversation history (default 20).
AGENT_MAX_HISTORY=20

# Minutes of inactivity before a user's conversation history is cleared (default 30).
AGENT_TTL_MINUTES=30
