# Timezone for forecast display (default: America/Los_Angeles)
TIMEZONE_DEFAULT=America/Los_Angeles
# Number of forecast days (default: 7, range 1-16)
FORECAST_DAYS=7
# HTTP client
HTTP_TIMEOUT_SECONDS=8
HTTP_RETRIES=2
# Cache
CACHE_TTL_SECONDS=900
CACHE_BACKEND=memory

# ── Telegram bot (Phase 4b) ──────────────────────────────────────────────────
# Get a token from @BotFather on Telegram.
# Required for the bot to run (polling or webhook mode).
TELEGRAM_BOT_TOKEN=

# Full HTTPS URL of the california-sail-api Cloud Run service.
# When set, the FastAPI service auto-registers the Telegram webhook on startup.
# Leave empty for local dev (use `python -m app.bot.telegram` for polling instead).
WEBHOOK_URL=
